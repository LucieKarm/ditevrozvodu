---
import type { QuizQuestion } from '../lib/courseQuizzes';

interface Props {
  questions: QuizQuestion[];
  lessonSlug: string;
}

const { questions, lessonSlug } = Astro.props;
const quizId = `quiz-${lessonSlug}`;
---

{
  questions.length > 0 && (
    <section
      class="rounded-2xl bg-white p-8 shadow-sm md:p-10 lg:p-12"
      aria-labelledby={`${quizId}-heading`}
    >
      <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-light-blue">
        Krátký kvíz
      </p>
      <h3
        id={`${quizId}-heading`}
        class="mb-3 text-2xl font-bold text-primary md:text-3xl"
      >
        Ověřte si, co si z kapitoly odnášíte
      </h3>
      <p class="mb-10 max-w-3xl text-base leading-relaxed text-gray-600 md:mb-12">
        Vyberte odpověď u každé otázky. Není to test na známky — slouží k zamyšlení.
      </p>

      <div class="course-quiz divide-y divide-gray-100" data-quiz-root={quizId}>
        {questions.map((q, qi) => (
          <fieldset
            class="course-quiz-question border-0 p-0 first:pt-0 last:pb-0 py-10 md:py-12"
            data-question-index={qi}
            data-correct={q.correct}
            data-hint={q.hint}
            data-explanation={q.explanation}
          >
            <legend class="sr-only">
              Otázka {qi + 1}: {q.question}
            </legend>
            <p class="mb-6 max-w-3xl text-lg font-semibold leading-relaxed text-primary md:mb-8 md:text-xl">
              <span class="text-light-blue">{qi + 1}.{' '}</span>
              {q.question}
            </p>
            <ul class="flex max-w-3xl flex-col gap-3 md:gap-4">
              {q.options.map((option, oi) => {
                const letter = ['A', 'B', 'C', 'D'][oi];
                const inputId = `${quizId}-q${qi}-${letter}`;
                return (
                  <li>
                    <label
                      for={inputId}
                      class="course-quiz-option flex cursor-pointer items-start gap-4 rounded-2xl border border-gray-200 bg-white px-5 py-4 text-base leading-relaxed text-gray-800 shadow-sm transition hover:border-light-blue hover:bg-sky-50/40 md:px-6 md:py-5 has-[:checked]:border-light-blue has-[:checked]:bg-sky-50/60"
                    >
                      <input
                        type="radio"
                        id={inputId}
                        name={`${quizId}-q${qi}`}
                        value={letter}
                        class="mt-1 h-5 w-5 shrink-0 accent-[var(--color-light-blue)]"
                      />
                      <span class="min-w-0 flex-1">
                        <span class="mr-1 font-bold text-primary">{letter}.</span>
                        {option}
                      </span>
                    </label>
                  </li>
                );
              })}
            </ul>
            <div
              class="course-quiz-feedback mt-6 hidden max-w-3xl rounded-2xl border-l-4 px-5 py-5 text-base leading-relaxed md:mt-8 md:px-6 md:py-6"
              role="status"
              aria-live="polite"
            />
          </fieldset>
        ))}
      </div>
    </section>
  )
}

<script>
  function escapeHtml(text: string) {
    return text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function initQuiz(root: HTMLElement) {
    root.querySelectorAll<HTMLElement>('.course-quiz-question').forEach((fieldset) => {
      const feedback = fieldset.querySelector<HTMLElement>('.course-quiz-feedback');
      if (!feedback) return;

      const correct = fieldset.dataset.correct ?? '';
      const hint = fieldset.dataset.hint ?? '';
      const explanation = fieldset.dataset.explanation ?? '';

      fieldset.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((input) => {
        input.addEventListener('change', () => {
          const chosen = input.value;
          const isCorrect = chosen === correct;

          fieldset.querySelectorAll('.course-quiz-option').forEach((label) => {
            label.classList.remove(
              'border-green-500',
              'bg-green-50',
              'ring-2',
              'ring-green-200',
              'border-red-400',
              'bg-red-50',
              'ring-red-100',
            );
          });

          const chosenLabel = input.closest('.course-quiz-option');
          if (chosenLabel) {
            if (isCorrect) {
              chosenLabel.classList.add('border-green-500', 'bg-green-50', 'ring-2', 'ring-green-200');
            } else {
              chosenLabel.classList.add('border-red-400', 'bg-red-50', 'ring-2', 'ring-red-100');
            }
          }

          if (!isCorrect) {
            const correctInput = fieldset.querySelector<HTMLInputElement>(
              `input[value="${correct}"]`,
            );
            const correctLabel = correctInput?.closest('.course-quiz-option');
            correctLabel?.classList.add('border-green-500', 'bg-green-50', 'ring-2', 'ring-green-200');
          }

          feedback.classList.remove('hidden');
          feedback.classList.toggle('border-green-500', isCorrect);
          feedback.classList.toggle('bg-green-50', isCorrect);
          feedback.classList.toggle('border-red-400', !isCorrect);
          feedback.classList.toggle('bg-red-50', !isCorrect);

          const detail = escapeHtml(explanation || hint);
          const title = isCorrect
            ? 'Správně!'
            : `Ještě ne. Správná odpověď je ${correct}.`;

          feedback.innerHTML = `
            <p class="mb-3 text-lg font-bold text-primary">${escapeHtml(title)}</p>
            ${detail ? `<p class="text-gray-700 leading-relaxed">${detail}</p>` : ''}
          `;
        });
      });
    });
  }

  document.querySelectorAll<HTMLElement>('[data-quiz-root]').forEach(initQuiz);
</script>

<style>
  .course-quiz-option:has(input:focus-visible) {
    outline: 2px solid var(--color-light-blue);
    outline-offset: 2px;
  }
</style>
