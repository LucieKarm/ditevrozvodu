---
import type { QuizQuestion } from '../lib/courseQuizzes';

interface Props {
  questions: QuizQuestion[];
  lessonSlug: string;
}

const { questions, lessonSlug } = Astro.props;
const quizId = `quiz-${lessonSlug}`;
---

{
  questions.length > 0 && (
    <section
      class="rounded-2xl bg-white p-8 shadow-sm"
      aria-labelledby={`${quizId}-heading`}
    >
      <p class="mb-1 text-sm font-semibold uppercase tracking-wide text-light-blue">
        Krátký kvíz
      </p>
      <h3 id={`${quizId}-heading`} class="mb-2 text-2xl font-bold text-primary">
        Ověřte si, co si z kapitoly odnášíte
      </h3>
      <p class="mb-8 text-gray-600">
        Vyberte odpověď u každé otázky. Není to test na známky — slouží k zamyšlení.
      </p>

      <div class="course-quiz space-y-10" data-quiz-root={quizId}>
        {questions.map((q, qi) => (
          <fieldset
            class="course-quiz-question border-0 p-0 m-0"
            data-question-index={qi}
            data-correct={q.correct}
            data-hint={q.hint}
            data-explanation={q.explanation}
          >
            <legend class="mb-4 text-lg font-semibold text-primary leading-snug">
              {qi + 1}. {q.question}
            </legend>
            <ul class="space-y-2">
              {q.options.map((option, oi) => {
                const letter = ['A', 'B', 'C', 'D'][oi];
                const inputId = `${quizId}-q${qi}-${letter}`;
                return (
                  <li>
                    <label
                      for={inputId}
                      class="course-quiz-option flex cursor-pointer gap-3 rounded-xl border border-gray-200 px-4 py-3 text-gray-800 transition hover:border-light-blue hover:bg-sky-50/50 has-[:checked]:border-light-blue has-[:checked]:bg-sky-50/80"
                    >
                      <input
                        type="radio"
                        id={inputId}
                        name={`${quizId}-q${qi}`}
                        value={letter}
                        class="mt-1 h-4 w-4 shrink-0 accent-[var(--color-light-blue)]"
                      />
                      <span>
                        <span class="font-semibold text-primary">{letter}.</span>{' '}
                        {option}
                      </span>
                    </label>
                  </li>
                );
              })}
            </ul>
            <div
              class="course-quiz-feedback mt-4 hidden rounded-xl border-l-4 px-4 py-3 text-[0.98rem] leading-relaxed"
              role="status"
              aria-live="polite"
            />
          </fieldset>
        ))}
      </div>
    </section>
  )
}

<script>
  function initQuiz(root: HTMLElement) {
    root.querySelectorAll<HTMLElement>('.course-quiz-question').forEach((fieldset) => {
      const feedback = fieldset.querySelector<HTMLElement>('.course-quiz-feedback');
      if (!feedback) return;

      const correct = fieldset.dataset.correct ?? '';
      const hint = fieldset.dataset.hint ?? '';
      const explanation = fieldset.dataset.explanation ?? '';

      fieldset.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((input) => {
        input.addEventListener('change', () => {
          const chosen = input.value;
          const isCorrect = chosen === correct;

          fieldset.querySelectorAll('.course-quiz-option').forEach((label) => {
            label.classList.remove(
              'border-green-500',
              'bg-green-50',
              'border-red-400',
              'bg-red-50/40',
            );
          });

          const chosenLabel = input.closest('.course-quiz-option');
          if (chosenLabel) {
            chosenLabel.classList.add(
              isCorrect ? 'border-green-500' : 'border-red-400',
              isCorrect ? 'bg-green-50' : 'bg-red-50/40',
            );
          }

          if (!isCorrect) {
            const correctInput = fieldset.querySelector<HTMLInputElement>(
              `input[value="${correct}"]`,
            );
            const correctLabel = correctInput?.closest('.course-quiz-option');
            correctLabel?.classList.add('border-green-500', 'bg-green-50');
          }

          feedback.classList.remove('hidden');
          feedback.classList.toggle('border-green-500', isCorrect);
          feedback.classList.toggle('bg-green-50', isCorrect);
          feedback.classList.toggle('text-primary', isCorrect);
          feedback.classList.toggle('border-light-blue', !isCorrect);
          feedback.classList.toggle('bg-sky-50/80', !isCorrect);

          const parts: string[] = [];
          if (isCorrect) {
            parts.push('<strong>Správně!</strong>');
          } else {
            parts.push(`<strong>Ještě ne.</strong> Správná odpověď je ${correct}.`);
          }
          const detail = explanation || hint;
          if (detail) {
            parts.push(detail);
          }
          feedback.innerHTML = parts.join(' ');
        });
      });
    });
  }

  document.querySelectorAll<HTMLElement>('[data-quiz-root]').forEach(initQuiz);
</script>

<style>
  .course-quiz-option:has(input:focus-visible) {
    outline: 2px solid var(--color-light-blue);
    outline-offset: 2px;
  }
</style>
