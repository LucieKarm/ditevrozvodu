---
import BaseLayout from './BaseLayout.astro';
import CourseNav from '../components/CourseNav.astro';

interface Props {
  title: string;
  description?: string;
  currentSlug?: string;
  hasAccess: boolean;
  userEmail?: string | null;
}

const {
  title,
  description = 'Online kurz pro rodiče: Jak mluvit s dětmi o rozpadu rodiny.',
  currentSlug,
  hasAccess,
  userEmail,
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <section class="bg-gradient-to-br from-primary to-[#1a1c4a] py-10 text-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <p class="mb-2 text-sm uppercase tracking-wide text-light-blue">Online kurz</p>
      <h1 class="text-3xl font-bold md:text-4xl">Jak mluvit s dětmi o rozpadu rodiny</h1>
      <div class="mt-4 flex flex-wrap items-center gap-3 text-sm">
        {
          userEmail ? (
            <span class="rounded-full bg-white/10 px-3 py-1">Přihlášen/a: {userEmail}</span>
          ) : (
            <a href="/prihlaseni?redirect=/kurz" class="rounded-full bg-white/10 px-3 py-1 hover:bg-white/20">
              Přihlásit se
            </a>
          )
        }
        {
          userEmail && (
            <form action="/api/auth/logout" method="post" class="inline">
              <button type="submit" class="rounded-full bg-white/10 px-3 py-1 hover:bg-white/20">
                Odhlásit se
              </button>
            </form>
          )
        }
      </div>
    </div>
  </section>

  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:px-6 lg:grid-cols-[280px_1fr] lg:px-8">
    <CourseNav currentSlug={currentSlug} hasAccess={hasAccess} />
    <main>
      <slot />
    </main>
  </div>
</BaseLayout>
