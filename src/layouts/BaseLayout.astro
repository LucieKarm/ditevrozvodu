---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = 'Dítě v rozvodu – Praktický průvodce rozvodem pro rodiče',
	description = 'Průvodce rozvodem, který pomáhá rodičům a dětem projít tímto obdobím v klidu a bezpečí.'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="cs">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;600;700&display=swap" rel="stylesheet">

		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-141WNY9F21"></script>
		<script is:inline>
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  gtag('js', new Date());

		  gtag('config', 'G-141WNY9F21');
		</script>
	</head>
	<body class="bg-gray-50 font-lexend">
		<Navigation />
		<slot />
		<Footer />
	</body>
</html>

<style is:global>
	:root {
		scroll-behavior: smooth;
	}
</style>
